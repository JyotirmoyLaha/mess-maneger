rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // ADMIN EMAIL - Only admin can modify access control
    // ============================================
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'jyotirmoy713128@gmail.com';
    }
    
    // ============================================
    // AUTHORIZED USERS - Check against Firestore data
    // ============================================
    function isAuthorizedUser() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/artifacts/$(resource.data.appId)/public/data/settings/access_control) &&
             request.auth.token.email.lower() in get(/databases/$(database)/documents/artifacts/$(resource.data.appId)/public/data/settings/access_control).data.authorized_emails;
    }
    
    // Simplified check - just verify auth exists (access control checked in app)
    function isSignedIn() {
      return request.auth != null;
    }
    
    // ============================================
    // ACCESS CONTROL SETTINGS
    // ============================================
    
    // Access control document - anyone can read (needed before auth), only admin can write
    match /artifacts/{appId}/public/data/settings/access_control {
      allow read: if true;  // Must be readable to check authorization
      allow write: if isAdmin();
    }
    
    // ============================================
    // MESS MANAGER DATA SECURITY RULES
    // ============================================
    
    // Fund summary document - allow authenticated users to read and write
    match /artifacts/{appId}/public/data/mess_fund/{document=**} {
      allow read, write: if isSignedIn();
    }
    
    // Mess expenses collection - authenticated users have access
    match /artifacts/{appId}/public/data/mess_expenses/{expenseId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.addedBy is string
                    && request.resource.data.item is string
                    && request.resource.data.cost is number
                    && request.resource.data.cost > 0;
      
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // Member fund contributions - authenticated users can read and write
    match /artifacts/{appId}/public/data/member_funds/{document=**} {
      allow read, write: if isSignedIn();
    }

    // Allow read access to other documents under data for authenticated users
    match /artifacts/{appId}/public/data/{document=**} {
      allow read: if isSignedIn();
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
